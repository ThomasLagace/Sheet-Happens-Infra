#!/bin/sh
# Re-assert agent/ tool paths as Git symlinks (mode 120000) if `git add`
# staged them as regular file copies, then fail the commit if the layout
# is still invalid.
set -e
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 1

run_node() {
  if command -v node >/dev/null 2>&1; then
    node "$@"
    return $?
  fi

  # Git GUI / some Windows hosts invoke hooks with a PATH that omits Node.
  for candidate in \
    "$PROGRAMFILES/nodejs/node.exe" \
    "$ProgramFiles/nodejs/node.exe" \
    "$LOCALAPPDATA/Programs/node/node.exe" \
    "/c/Program Files/nodejs/node.exe" \
    "/mnt/c/Program Files/nodejs/node.exe"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      "$candidate" "$@"
      return $?
    fi
  done

  if command -v where >/dev/null 2>&1; then
    found="$(where node 2>/dev/null | head -n 1 | tr -d '\r')"
    if [ -n "$found" ] && [ -f "$found" ]; then
      "$found" "$@"
      return $?
    fi
  fi

  echo "pre-commit: node not found (install Node.js or put it on PATH)" >&2
  return 127
}

run_node scripts/check-agent-symlinks.mjs --fix
